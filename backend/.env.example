# Copy to .env and fill in. Never commit the real file.
PORT=7000
NODE_ENV=development

# MongoDB (Atlas connection string, or a local mongod)
MONGO_URI=mongodb+srv://CLUSTER.mongodb.net/smart-expense
# Optional: keep credentials out of the URI
MONGO_USER=
MONGO_PASSWORD=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Brevo transactional email API key (used for signup OTP emails)
BREVO_API_KEY=

# Extra browser origins allowed by CORS (comma-separated, exact origins)
ALLOWED_ORIGINS=
FRONTEND_URL=
