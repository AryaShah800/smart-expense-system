# Server
PORT=7000
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGO_URI=
# Optional: only if credentials are kept separate from the URI
MONGO_USER=
MONGO_PASSWORD=

# Auth: required. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email (Brevo transactional API) for OTP verification
BREVO_API_KEY=

# Local testing only. Leave unset (or false) everywhere else.
# When it is not "true", the GET /api/users/debug/otp route is not registered at all.
ENABLE_DEBUG_OTP=false
