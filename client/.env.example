# Leave empty in development to use the local API.
VITE_API_URL=http://localhost:7000/api
VITE_SOCKET_URL=http://localhost:7000

# Sentry error monitoring. Leave empty to turn Sentry off.
VITE_SENTRY_DSN=

# Source-map upload at build time (set these in Vercel, never commit them).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
