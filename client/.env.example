# API base URL.
# Production (Vercel): "/api" so requests go through the vercel.json rewrite and the
# auth cookie stays first-party. Local dev: http://localhost:7000/api
VITE_API_URL=http://localhost:7000/api

# Socket.io server origin. Vercel can't proxy WebSockets, so in production point this
# directly at the API, e.g. https://smart-expense-system-api.onrender.com
VITE_SOCKET_URL=http://localhost:7000
